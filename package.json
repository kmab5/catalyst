{
  "name": "catalyst",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"!@catalyst/web\" --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "@types/node": "^22.15.0",
    "vitest": "^4.1.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vite": "^6.4.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
