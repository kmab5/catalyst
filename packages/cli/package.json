{
  "name": "catalyst-dx",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@catalyst/shared": "workspace:*",
    "@catalyst/core": "workspace:*",
    "@catalyst/server": "workspace:*"
  },
  "bin": {
    "catalyst": "./dist/index.js"
  }
}
